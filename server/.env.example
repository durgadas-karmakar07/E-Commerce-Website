# Server Environment Variables
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/aura_ecommerce
JWT_SECRET=aura_super_secure_jwt_secret_key_2026_antigravity
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: External Payment Gateway (Razorpay)
# If left blank, the platform automatically runs in secure Demo Payment Gateway mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: External Media Storage (Cloudinary)
# If left blank, uploaded files are securely served locally via /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Firebase Authentication
# If left blank, local JWT authentication and instant demo phone OTP (123456) are used
FIREBASE_PROJECT_ID=

# Optional: Sentry Error Monitoring
SENTRY_DSN=
